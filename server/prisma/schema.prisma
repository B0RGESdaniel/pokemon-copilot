datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

// Contexto de jogo/geração é definido por save, não por Pokémon individual
// (ver pokemon-copilot/CLAUDE ou histórico do PR que introduziu isso).
model Save {
  id         String   @id @default(cuid())
  name       String
  game       String
  generation Int
  createdAt  DateTime @default(now())

  pokemons      Pokemon[]
  battleSession BattleSession?
}

// SQLite não suporta enum nem Json nativamente no Prisma.
// `location` é validado na aplicação como "PARTY" | "PC" (ver pokemon.types.ts).
// `moves` guarda um array de strings serializado em JSON (texto).
model Pokemon {
  id           String   @id @default(cuid())
  saveId       String
  save         Save     @relation(fields: [saveId], references: [id])
  pokeApiId    Int
  nickname     String?
  level        Int
  heldItem     String?
  location     String
  slotPosition Int?
  moves        String   @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  activeInBattles BattleSession[]

  @@unique([saveId, location, slotPosition])
}

// Estado da batalha em andamento (menu de troca). Uma por save — iniciar
// uma nova batalha reseta essa mesma linha em vez de criar histórico, já
// que não guardamos histórico de batalhas nesta fase.
model BattleSession {
  id                String   @id @default(cuid())
  saveId            String   @unique
  save              Save     @relation(fields: [saveId], references: [id])
  activePokemonId   String
  activePokemon     Pokemon  @relation(fields: [activePokemonId], references: [id])
  opponentPokeApiId Int?
  opponentLevel     Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Cache persistente de respostas da PokeAPI (dados essencialmente estáticos:
// espécie, move e item não mudam). Sem TTL de propósito — ver src/lib/pokeapi/cache.ts.
model PokeApiCacheEntry {
  key       String   @id
  payload   String
  fetchedAt DateTime @default(now())
}
